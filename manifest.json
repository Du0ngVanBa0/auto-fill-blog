{
  "manifest_version": 3,
  "name": "Auto Fill Blog",
  "version": "1.3.4",
  "description": "Điền bài từ Sheets hoặc file nội dung local vào DramaStudio theo nhiều hàng. Bạn kiểm tra trước khi tự lưu.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Auto Fill Blog · Du0ngVanBa0",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["https://docs.google.com/*", "https://dramastudio.danhngon.pro/*", "file:///*"]
}
